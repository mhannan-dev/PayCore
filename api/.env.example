# MFA sign-in and step-up enforcement. Defaults to true when unset.
MFA_ENABLED=true
# PayCore API configuration. Copy to api/.env (git-ignored) and adjust.
# Placeholder values only: never commit real credentials.

# --- Server -------------------------------------------------------------------
PORT=8080
# development | production. Development allows any loopback CORS origin and,
# without an SMTP server, writes emails (including one-time links) to the log.
ENV=development
# Generate once from api with: go run ./cmd/mfa-key
# Keep the resulting key stable and backed up; never commit a real key.
# MFA_ENCRYPTION_KEY=<base64-encoded 32 random bytes>
# Comma-separated browser origins allowed by CORS. Set your console URL in production.
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the web console, used in invitation and password-reset links.
# run.ps1 sets it to the web port it selects when left unset.
# APP_URL=https://console.example.com

# --- Data ---------------------------------------------------------------------
# Local development database from compose.yaml (development-only password).
DATABASE_URL=postgres://paycore:paycore_local_dev@127.0.0.1:5434/paycore?sslmode=disable
# Uploaded files, stored outside the web root.
UPLOAD_DIR=uploads
# Reserved for the planned idempotency cache; not used yet.
REDIS_URL=localhost:6379

# --- Event outbox relay -------------------------------------------------------
# log (default) or webhook. A webhook can bridge events to a broker/consumer.
OUTBOX_PUBLISHER=log
# Required when OUTBOX_PUBLISHER=webhook.
# OUTBOX_WEBHOOK_URL=https://consumer.example.com/paycore/events
# Shared secret for X-PayCore-Signature: sha256=<HMAC-SHA256(body)>. Keep secret.
# OUTBOX_WEBHOOK_SECRET=
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
OUTBOX_INTERVAL_SECONDS=1

# --- Email (SMTP) -------------------------------------------------------------
# Leave SMTP_HOST empty in development: run.ps1 then uses the local Mailpit inbox
# (http://localhost:8025). Check settings with: go run ./cmd/mail-check
SMTP_HOST=
# Defaults from SMTP_ENCRYPTION: starttls → 587, tls → 465, none → 1025.
SMTP_PORT=
# starttls (required, never opportunistic) | tls (port 465) | none (localhost only)
SMTP_ENCRYPTION=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME when that is an address (Microsoft 365 requires this).
SMTP_FROM="PayCore <no-reply@example.com>"

# Alternatively, Laravel-style names are accepted when SMTP_HOST is unset.
# The two sets are never mixed.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=starttls
# MAIL_USERNAME=mailbox@example.com
# MAIL_PASSWORD=change-me
# MAIL_FROM_ADDRESS=mailbox@example.com
# MAIL_FROM_NAME=PayCore
