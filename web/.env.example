# PayCore web console configuration. Copy to web/.env.local (git-ignored).
# NEXT_PUBLIC_* values are compiled into the browser bundle: never put secrets here.

# API base URL. run.ps1 sets this automatically to the API port it selects.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Development only: password filled in when a demo identity is picked on the login
# page. Must match the password used with `go run ./cmd/seed-users`. Ignored in
# production builds. Leave empty to type the password manually.
NEXT_PUBLIC_DEMO_PASSWORD=
