# ---------------------------------------------------------------------------
# Secrets and local configuration: never commit real credentials.
# Only the *.example templates are tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
*.secret
secrets/

# ---------------------------------------------------------------------------
# Go API
# ---------------------------------------------------------------------------
api/bin/
api/tmp/
api/uploads/
api/build-errors.log
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt
coverage.html
*.coverprofile
__debug_bin*
go.work
go.work.sum

# ---------------------------------------------------------------------------
# Next.js web
# ---------------------------------------------------------------------------
node_modules/
web/.next/
web/out/
web/build/
web/coverage/
web/next-env.d.ts
*.tsbuildinfo
.vercel/
.turbo/
.swc/
web/test-results/
web/playwright-report/
web/blob-report/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Local data, dumps and overrides
# ---------------------------------------------------------------------------
compose.override.yaml
compose.override.yml
docker-compose.override.yml
*.dump
*.sql.gz
*.backup
*.sqlite
*.sqlite3
*.db
dump.rdb
backups/

# ---------------------------------------------------------------------------
# Logs and runtime files
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid

